# What the source distribution carries beyond the package itself.
#
# setuptools picked up tests/*.py on its own but not the data those tests read,
# so the sdist shipped tests/test_vectors.py without tests/vectors/*.json and
# tests/test_gui.py without tests/support.py. Running the suite from the built
# archive produced four failures for "zero vectors found" plus import errors,
# while the same suite passed in the repository (2026-08-02 review, F-12).
#
# That matters more than a broken test run: the pinned vectors are how anyone
# verifies that a MORPHEUS build decrypts what earlier versions produced. An
# sdist that omits them cannot be checked by the person who downloaded it, which
# is the one audience for a source distribution.
recursive-include tests *.py
recursive-include tests/vectors *.json

include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include requirements.txt
include requirements-lock.txt
include morpheus.py

recursive-include docs *.md
recursive-include docs/screens *.svg

# Never ship local tooling or working notes.
prune tasks
prune .github
prune .claude
global-exclude __pycache__ *.py[cod] .DS_Store
